#!/usr/bin/env bash
set -euo pipefail

DOTENVX="${DOTENVX:-dotenvx}"
DEFAULT_HOME="${HOME:-}"
DEFAULT_CWD="$PWD"
STAGE_DIR="${TMPDIR:-/tmp}/vp-env-secrets"
STAGE_FILE="$STAGE_DIR/.env.staged"

usage() {
  cat <<'EOF'
Usage:
  envctl doctor
  envctl list [--cwd DIR] [--home DIR] [--keys|--no-keys]
  envctl order [--cwd DIR] [--home DIR] [--env NAME] [--overload]
  envctl run [--cwd DIR] [--home DIR] [--env NAME] [--overload] [--allow-command-substitution] -- COMMAND [ARGS...]
  envctl stage-from-file KEY FILE
  envctl verify-staged KEY
  envctl persist-staged KEY --target FILE --mode append|override|replace [--allow-unsafe-target]
  envctl clean

This helper never prints env values. Do not pass raw secrets as arguments.
EOF
}

die() {
  printf 'Error: %s\n' "$*" >&2
  exit 1
}

cmd_doctor() {
  if command -v "$DOTENVX" >/dev/null 2>&1; then
    printf 'dotenvx: found\n'
    printf 'path: %s\n' "$(command -v "$DOTENVX")"
    printf 'version: '
    "$DOTENVX" --version
    return 0
  fi

  printf 'dotenvx: missing\n'
  printf 'install_options: mise | brew | npm/npx\n'
  printf 'confirm before installing; follow the local toolchain convention\n'
  return 1
}

need_arg() {
  [ $# -gt 1 ] || die "$1 requires a value"
}

validate_key() {
  local key="$1"
  [[ "$key" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || die "invalid env key: $key"
}

abs_path() {
  local path="$1"
  if [ -d "$path" ]; then
    (cd "$path" && pwd -P)
  else
    local dir base
    dir="$(dirname "$path")"
    base="$(basename "$path")"
    (cd "$dir" 2>/dev/null && printf '%s/%s\n' "$(pwd -P)" "$base") || printf '%s\n' "$path"
  fi
}

classify_file() {
  local base="$1"
  case "$base" in
    .env.example|.env.sample|.env.template|*.example|*.sample|*.template)
      printf 'template'
      ;;
    .env.keys)
      printf 'dotenvx-keys'
      ;;
    *.production|*.production.local|*.staging|*.staging.local|*.prod|*.prod.local|*.stage|*.stage.local)
      printf 'production-like'
      ;;
    *.local)
      printf 'local-secret'
      ;;
    .env)
      printf 'base-env'
      ;;
    *)
      printf 'env-variant'
      ;;
  esac
}

key_names() {
  sed -nE 's/^[[:space:]]*(export[[:space:]]+)?([A-Za-z_][A-Za-z0-9_]*)[[:space:]]*=.*/\2/p' "$1"
}

key_line_count() {
  key_names "$1" | wc -l | tr -d ' '
}

contains_command_substitution() {
  grep -qE '(\$\(|`)' "$1"
}

git_state() {
  local cwd="$1"
  local path="$2"
  local repo_root
  repo_root="$(git -C "$cwd" rev-parse --show-toplevel 2>/dev/null || true)"
  [ -n "$repo_root" ] || {
    printf 'not-git'
    return
  }

  local rel
  rel="${path#$repo_root/}"
  (
    cd "$repo_root"
    if git ls-files --error-unmatch "$rel" >/dev/null 2>&1; then
      printf 'tracked'
    elif git check-ignore -q "$rel"; then
      printf 'ignored'
    else
      printf 'not-ignored'
    fi
  )
}

risk_flags() {
  local scope="$1"
  local cwd="$2"
  local path="$3"
  local class="$4"
  local flags=()

  if [ "$scope" = "cwd" ] && [ "$class" != "template" ]; then
    local git
    git="$(git_state "$cwd" "$path")"
    case "$git" in
      tracked) flags+=("tracked") ;;
      not-ignored) flags+=("not-ignored") ;;
    esac
  fi

  if [ "$class" != "template" ]; then
    local perms
    perms="$(stat -f '%Lp' "$path" 2>/dev/null || stat -c '%a' "$path" 2>/dev/null || printf '999')"
    [ "$perms" -le 600 ] || flags+=("broad-perms")
  fi

  contains_command_substitution "$path" && flags+=("command-substitution")

  local duplicates
  duplicates="$(key_names "$path" | sort | uniq -d | wc -l | tr -d ' ')"
  [ "$duplicates" = "0" ] || flags+=("duplicate-keys:$duplicates")

  case "$class" in
    production-like) flags+=("explicit-only") ;;
    dotenvx-keys) flags+=("do-not-load-as-env") ;;
  esac

  if [ "${#flags[@]}" -eq 0 ]; then
    printf 'none'
  else
    local IFS=','
    printf '%s' "${flags[*]}"
  fi
}

iter_env_files() {
  local scope="$1"
  local dir="$2"
  local path

  [ -d "$dir" ] || return 0
  for path in "$dir"/.env "$dir"/.env.*; do
    [ -e "$path" ] || continue
    [ -f "$path" ] || continue
    printf '%s\t%s\n' "$scope" "$(abs_path "$path")"
  done
}

cmd_list() {
  local cwd="$DEFAULT_CWD"
  local home="$DEFAULT_HOME"
  local show_keys=true

  while [ $# -gt 0 ]; do
    case "$1" in
      --cwd)
        need_arg "$1" "$@"
        cwd="$(abs_path "$2")"
        shift 2
        ;;
      --cwd=*)
        cwd="$(abs_path "${1#--cwd=}")"
        shift
        ;;
      --home)
        need_arg "$1" "$@"
        home="$(abs_path "$2")"
        shift 2
        ;;
      --home=*)
        home="$(abs_path "${1#--home=}")"
        shift
        ;;
      --keys)
        show_keys=true
        shift
        ;;
      --no-keys)
        show_keys=false
        shift
        ;;
      -h|--help)
        usage
        return 0
        ;;
      *)
        die "unknown list option: $1"
        ;;
    esac
  done

  printf 'idx\tscope\tclass\tgit\tperms\tkey_count\tkeys\tpath\trisks\n'
  local idx=0
  local scope path base class git perms count keys risks
  while IFS=$'\t' read -r scope path; do
    idx=$((idx + 1))
    base="$(basename "$path")"
    class="$(classify_file "$base")"
    if [ "$scope" = "cwd" ]; then
      git="$(git_state "$cwd" "$path")"
    else
      git='n/a'
    fi
    perms="$(stat -f '%Lp' "$path" 2>/dev/null || stat -c '%a' "$path" 2>/dev/null || printf 'unknown')"
    count="$(key_line_count "$path")"
    if $show_keys; then
      keys="$(key_names "$path" | paste -sd, -)"
      [ -n "$keys" ] || keys='none'
    else
      keys='hidden'
    fi
    risks="$(risk_flags "$scope" "$cwd" "$path" "$class")"
    printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
      "$idx" "$scope" "$class" "$git" "$perms" "$count" "$keys" "$path" "$risks"
  done < <(
    iter_env_files home "$home"
    iter_env_files cwd "$cwd"
  )

}

precedence_high_to_low() {
  local cwd="$1"
  local home="$2"
  local env_name="${3:-}"

  if [ -n "$env_name" ]; then
    printf '%s\n' \
      "$cwd/.env.$env_name.local" \
      "$cwd/.env.local" \
      "$cwd/.env.$env_name" \
      "$cwd/.env" \
      "$home/.env.$env_name.local" \
      "$home/.env.local" \
      "$home/.env.$env_name" \
      "$home/.env"
  else
    printf '%s\n' \
      "$cwd/.env.local" \
      "$cwd/.env" \
      "$home/.env.local" \
      "$home/.env"
  fi
}

dotenvx_args() {
  local cwd="$1"
  local home="$2"
  local env_name="$3"
  local overload="$4"
  local files=()
  local file

  while IFS= read -r file; do
    [ -f "$file" ] && files+=("$(abs_path "$file")")
  done < <(precedence_high_to_low "$cwd" "$home" "$env_name")
  [ "${#files[@]}" -gt 0 ] || return 0

  if $overload; then
    local i
    for ((i=${#files[@]}-1; i>=0; i--)); do
      printf '%s\n' "${files[$i]}"
    done
  else
    for file in "${files[@]}"; do
      printf '%s\n' "$file"
    done
  fi
}

parse_resolver_options() {
  RESOLVER_CWD="$DEFAULT_CWD"
  RESOLVER_HOME="$DEFAULT_HOME"
  RESOLVER_ENV=""
  RESOLVER_OVERLOAD=false
  RESOLVER_ALLOW_COMMAND_SUBSTITUTION=false
  RESOLVER_REMAINING=()

  while [ $# -gt 0 ]; do
    case "$1" in
      --cwd)
        need_arg "$1" "$@"
        RESOLVER_CWD="$(abs_path "$2")"
        shift 2
        ;;
      --cwd=*)
        RESOLVER_CWD="$(abs_path "${1#--cwd=}")"
        shift
        ;;
      --home)
        need_arg "$1" "$@"
        RESOLVER_HOME="$(abs_path "$2")"
        shift 2
        ;;
      --home=*)
        RESOLVER_HOME="$(abs_path "${1#--home=}")"
        shift
        ;;
      --env)
        need_arg "$1" "$@"
        RESOLVER_ENV="$2"
        shift 2
        ;;
      --env=*)
        RESOLVER_ENV="${1#--env=}"
        shift
        ;;
      --overload)
        RESOLVER_OVERLOAD=true
        shift
        ;;
      --allow-command-substitution)
        RESOLVER_ALLOW_COMMAND_SUBSTITUTION=true
        shift
        ;;
      --)
        shift
        RESOLVER_REMAINING=("$@")
        break
        ;;
      -h|--help)
        usage
        exit 0
        ;;
      *)
        die "unknown resolver option: $1"
        ;;
    esac
  done
}

cmd_order() {
  parse_resolver_options "$@"
  printf 'mode: %s\n' "$($RESOLVER_OVERLOAD && printf overload || printf default)"
  printf 'final_precedence: local-first\n'
  printf 'dotenvx_files:\n'
  local path idx=0
  while IFS= read -r path; do
    idx=$((idx + 1))
    printf '  %s. %s\n' "$idx" "$path"
  done < <(dotenvx_args "$RESOLVER_CWD" "$RESOLVER_HOME" "$RESOLVER_ENV" "$RESOLVER_OVERLOAD")
}

cmd_run() {
  parse_resolver_options "$@"
  [ "${#RESOLVER_REMAINING[@]}" -gt 0 ] || die "run requires -- COMMAND"
  command -v "$DOTENVX" >/dev/null 2>&1 || die "dotenvx not found"

  local files=()
  local path
  while IFS= read -r path; do
    files+=("$path")
  done < <(dotenvx_args "$RESOLVER_CWD" "$RESOLVER_HOME" "$RESOLVER_ENV" "$RESOLVER_OVERLOAD")
  [ "${#files[@]}" -gt 0 ] || die "no env files resolved"

  if ! $RESOLVER_ALLOW_COMMAND_SUBSTITUTION; then
    for path in "${files[@]}"; do
      if contains_command_substitution "$path"; then
        die "command substitution detected in $path; rerun with --allow-command-substitution only after explicit confirmation"
      fi
    done
  fi

  local args=()
  for path in "${files[@]}"; do
    args+=("-f" "$path")
  done

  if $RESOLVER_OVERLOAD; then
    exec "$DOTENVX" run "${args[@]}" --strict --quiet --overload -- "${RESOLVER_REMAINING[@]}"
  else
    exec "$DOTENVX" run "${args[@]}" --strict --quiet -- "${RESOLVER_REMAINING[@]}"
  fi
}

quote_dotenv_value() {
  local value="$1"
  if [[ "$value" == *$'\n'* ]]; then
    die "multiline values are not supported by this first-version helper"
  fi
  local backtick='`'
  value="${value//\\/\\\\}"
  value="${value//\"/\\\"}"
  value="${value//\$/\\\$}"
  value="${value//$backtick/\\$backtick}"
  printf '"%s"' "$value"
}

cmd_stage_from_file() {
  [ $# -eq 2 ] || die "stage-from-file requires KEY FILE"
  local key="$1"
  local input="$2"
  validate_key "$key"
  [ -f "$input" ] || die "input file not found: $input"

  local value
  local value_count
  value_count="$(sed '/^[[:space:]]*#/d; /^[[:space:]]*$/d' "$input" | wc -l | tr -d ' ')"
  [ "$value_count" -le 1 ] || die "input has multiple non-comment lines; multiline values are not supported by this first-version helper"
  value="$(sed '/^[[:space:]]*#/d; /^[[:space:]]*$/d' "$input" | sed -n '1p')"
  [ -n "$value" ] || die "no non-comment value found in input file"

  (umask 077; mkdir -p "$STAGE_DIR")
  printf '%s=%s\n' "$key" "$(quote_dotenv_value "$value")" >> "$STAGE_FILE"
  chmod 600 "$STAGE_FILE"
  rm -f "$input"
  printf 'staged:%s:%s\n' "$key" "${#value}"
}

cmd_verify_staged() {
  [ $# -eq 1 ] || die "verify-staged requires KEY"
  local key="$1"
  validate_key "$key"
  [ -f "$STAGE_FILE" ] || die "staging file not found"
  "$DOTENVX" run -f "$STAGE_FILE" --strict --quiet -- sh -c '
    key="$1"
    if value="$(printenv "$key")"; then
      printf "set:%s:%s\n" "$key" "${#value}"
    else
      printf "unset:%s\n" "$key"
      exit 1
    fi
  ' sh "$key"
}

target_is_forbidden() {
  local target="$1"
  local base
  base="$(basename "$target")"
  case "$base" in
    .env|.env.*)
      ;;
    *)
      return 0
      ;;
  esac
  case "$(classify_file "$base")" in
    template|dotenvx-keys)
      return 0
      ;;
  esac
  return 1
}

cmd_persist_staged() {
  local key=""
  local target=""
  local mode=""
  local allow_unsafe_target=false

  [ $# -gt 0 ] || die "persist-staged requires KEY"
  key="$1"
  validate_key "$key"
  shift

  while [ $# -gt 0 ]; do
    case "$1" in
      --target)
        need_arg "$1" "$@"
        target="$2"
        shift 2
        ;;
      --target=*)
        target="${1#--target=}"
        shift
        ;;
      --mode)
        need_arg "$1" "$@"
        mode="$2"
        shift 2
        ;;
      --mode=*)
        mode="${1#--mode=}"
        shift
        ;;
      --allow-unsafe-target)
        allow_unsafe_target=true
        shift
        ;;
      *)
        die "unknown persist option: $1"
        ;;
    esac
  done

  [ -n "$target" ] || die "--target is required"
  [ -n "$mode" ] || die "--mode is required"
  case "$mode" in append|override|replace) ;; *) die "--mode must be append, override, or replace" ;; esac
  target="$(abs_path "$target")"
  target_is_forbidden "$target" && die "refuse to persist to forbidden target: $target"
  if ! $allow_unsafe_target; then
    local target_dir target_probe_dir repo_root rel target_state
    target_dir="$(dirname "$target")"
    target_probe_dir="$target_dir"
    while [ ! -d "$target_probe_dir" ] && [ "$target_probe_dir" != "/" ]; do
      target_probe_dir="$(dirname "$target_probe_dir")"
    done
    repo_root="$(git -C "$target_probe_dir" rev-parse --show-toplevel 2>/dev/null || true)"
    if [ -n "$repo_root" ]; then
      rel="${target#$repo_root/}"
      if git -C "$repo_root" ls-files --error-unmatch "$rel" >/dev/null 2>&1; then
        target_state="tracked"
      elif git -C "$repo_root" check-ignore -q "$rel"; then
        target_state="ignored"
      else
        target_state="not-ignored"
      fi
      case "$target_state" in
        tracked|not-ignored)
          die "refuse to persist to $target_state git target: $target; rerun with --allow-unsafe-target only after explicit confirmation"
          ;;
      esac
    fi
  fi
  [ -f "$STAGE_FILE" ] || die "staging file not found"

  local staged_line
  staged_line="$(grep -E "^${key}=" "$STAGE_FILE" | tail -n 1 || true)"
  [ -n "$staged_line" ] || die "key not found in staging file: $key"

  mkdir -p "$(dirname "$target")"
  if [ ! -e "$target" ]; then
    (umask 077; : > "$target")
  fi
  chmod 600 "$target"

  local exists=false
  if grep -Eq "^[[:space:]]*(export[[:space:]]+)?${key}[[:space:]]*=" "$target"; then
    exists=true
  fi

  case "$mode" in
    append)
      $exists && die "target already has key; choose override or replace"
      printf '\n# Added by envctl\n%s\n' "$staged_line" >> "$target"
      ;;
    override)
      if $exists; then
        tmp="$(mktemp)"
        sed -E "s/^([[:space:]]*(export[[:space:]]+)?${key}[[:space:]]*=)/# envctl override: \1/" "$target" > "$tmp"
        cat "$tmp" > "$target"
        rm -f "$tmp"
      fi
      printf '\n# Added by envctl override\n%s\n' "$staged_line" >> "$target"
      ;;
    replace)
      if $exists; then
        tmp="$(mktemp)"
        grep -Ev "^[[:space:]]*(export[[:space:]]+)?${key}[[:space:]]*=" "$target" > "$tmp" || true
        cat "$tmp" > "$target"
        rm -f "$tmp"
      fi
      printf '\n# Added by envctl replace\n%s\n' "$staged_line" >> "$target"
      ;;
  esac

  chmod 600 "$target"
  cmd_verify_target "$key" "$target"
}

cmd_verify_target() {
  local key="$1"
  local target="$2"
  "$DOTENVX" run -f "$target" --strict --quiet -- sh -c '
    key="$1"
    if value="$(printenv "$key")"; then
      printf "persisted:%s:%s\n" "$key" "${#value}"
    else
      printf "missing:%s\n" "$key"
      exit 1
    fi
  ' sh "$key"
}

cmd_clean() {
  rm -f "$STAGE_FILE"
  rmdir "$STAGE_DIR" 2>/dev/null || true
  printf 'cleaned\n'
}

main() {
  [ $# -gt 0 ] || {
    usage
    exit 1
  }

  local cmd="$1"
  shift
  case "$cmd" in
    doctor) cmd_doctor "$@" ;;
    list) cmd_list "$@" ;;
    order) cmd_order "$@" ;;
    run) cmd_run "$@" ;;
    stage-from-file) cmd_stage_from_file "$@" ;;
    verify-staged) cmd_verify_staged "$@" ;;
    persist-staged) cmd_persist_staged "$@" ;;
    clean) cmd_clean "$@" ;;
    -h|--help|help) usage ;;
    *) die "unknown command: $cmd" ;;
  esac
}

main "$@"
